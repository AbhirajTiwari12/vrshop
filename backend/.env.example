# ---- Server ----
PORT=8787
# Public URL the Quest + phone use to reach this server (LAN IP or tunnel URL).
# Leave empty to auto-detect the LAN IP.
PUBLIC_BASE_URL=

# ---- AI (room analysis, ranking, voice intent, transcription) ----
OPENAI_API_KEY=
# Fast/cheap model for ranking + voice intent, and a stronger one for the room photos.
OPENAI_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=gpt-6-sol
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# The designer's spoken voice in the headset (text to speech; cached in data/tts). Voices: coral, sage, nova, shimmer, ash...
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ---- Product search ----
# Google Shopping (Amazon, Wayfair, Target, Walmart, West Elm, ...). Either key works; Serper.dev wins if both are set.
#   Serper.dev: 2,500 free queries (no card), then ~$1 / 1k   -> https://serper.dev
#   SerpAPI:    250 free / month, then ~$15-25 / 1k           -> https://serpapi.com
SERPER_API_KEY=
SERPAPI_KEY=
# SHOPPING_PROVIDER=auto|serper|serpapi|none
SHOPPING_PROVIDER=auto
# Voice/typed requests search the pulled catalog first (free), then IKEA (free), and only hit Google Shopping when
# there are still fewer than LIVE_MIN_RESULTS matches (1 = only when nothing matches). LIVE_SEARCH=off never searches
# live. SHOPPING_MONTHLY_LIMIT is a hard cap on every paid call per month, the catalog pull included.
LIVE_SEARCH=fallback
LIVE_MIN_RESULTS=1
SHOPPING_MONTHLY_LIMIT=200
# Demo mode: only offer products with an official 3D model (IKEA); never runs paid searches or paid 3D generation.
# Run `npm run catalog:check-3d` once first so the catalog knows which products have one.
DEMO_3D_ONLY=off

# IKEA market used for search + official 3D models
IKEA_COUNTRY=us
IKEA_LANG=en

# ---- Image -> 3D (used for non-IKEA products). First key present wins unless GEN_PROVIDER is set.
# GEN_PROVIDER=auto|fal|meshy|tripo|none
GEN_PROVIDER=auto
FAL_KEY=
# trellis2 (fast, MIT) | hunyuan (sharp PBR) | rodin (best upholstery, honors real dims)
FAL_MODEL=trellis2
MESHY_API_KEY=
TRIPO_API_KEY=

# ---- Visa: agentic checkout ("buy the room") ----
# Visa Acceptance (Cybersource) sandbox: real card authorizations (capture=false) + reversals + Pay by Link.
# Self-serve in minutes: https://developer.visaacceptance.com/hello-world/sandbox.html
#   Business Center -> Payment Configuration -> Key Management -> Generate key -> REST - Shared Secret.
# Without these, authorizations are simulated and clearly labelled "simulated" in the apps.
VISA_ACCEPTANCE_HOST=apitest.cybersource.com
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_KEY_ID=
VISA_ACCEPTANCE_SECRET_KEY=
# Card on file for the demo shopper: Visa's published sandbox test card. Never put a real card here.
VISA_TEST_CARD_NUMBER=4111111111111111
VISA_TEST_CARD_EXP_MONTH=12
VISA_TEST_CARD_EXP_YEAR=2031
# Trusted Agent Protocol signing key (Ed25519 PKCS#8 PEM, "\n" for newlines). Empty: generated once in data/.
TAP_PRIVATE_KEY=
# Pause between checkout steps so the timeline is watchable in the headset (ms).
CHECKOUT_STEP_DELAY_MS=450
